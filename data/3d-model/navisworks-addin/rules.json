    {
      "name": "Scaffolding and temporary works",
      "category": "Item",
      "property": "Category",
      "matchType": "Contains",
      "values": ["Scaffold", "Temporary Works", "Falsework"]
    },
    {
      "name": "Theoretical safety / exclusion zones",
      "category": "Item",
      "property": "Category",
      "matchType": "Contains",
      "values": ["Safety Zone", "Exclusion Zone", "Swept Path", "Clearance Envelope", "Working Area"]
    }
  ],

