{
  "name": "projectflow",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "pnpm --filter @projectflow/api dev",
    "dev:web": "pnpm --filter @projectflow/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev:sheets-api": "pnpm --filter @projectflow/sheets dev",
    "dev:web-sheets": "pnpm --filter @projectflow/web dev:sheets",
    "build:sheets": "pnpm --filter @projectflow/sheets build"
  }
}