# Copy to .env.sheets.local (git-ignored) and fill in after deploying the Apps Script web app.
VITE_SHEETS_URL=https://script.google.com/macros/s/AKfycb.../exec
# The value shown by the spreadsheet menu: Project Flow > Show API token
VITE_SHEETS_TOKEN=

# The Google Sheet that holds the data; shown under Settings > Data sources.
VITE_SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/.../edit
