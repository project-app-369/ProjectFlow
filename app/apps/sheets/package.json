{
  "name": "@projectflow/sheets",
  "version": "0.1.0",
  "private": true,
  "description": "Pre-build backend: Google Apps Script web app over a Google Spreadsheet, same REST contract as the NestJS API.",
  "scripts": {
    "build": "node scripts/build.mjs",
