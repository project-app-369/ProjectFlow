    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/google-apps-script": "^2.0.15",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^5.1.0"
  }
}
