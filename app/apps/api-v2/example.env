# Copy to .env.local, then fill in values. Never commit .env.local.
# Use the Supabase Session pooler URI (IPv4 compatible). TLS uses the bundled Supabase root certificate.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
API_V2_TOKEN=replace-with-a-long-random-secret
GOOGLE_SHEETS_EXEC_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
GOOGLE_SHEETS_API_TOKEN=replace-with-existing-sheets-token
BACKUP_SHEET_URL=https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
PORT=3300
