{
  "name": "@projectflow/api-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env.local --import tsx src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/server.mjs",
    "build:edge-v3": "esbuild src/edge-v3.ts --bundle --platform=neutral --target=es2022 --format=esm --alias:zod=npm:zod@4.6.7 --external:npm:* --external:node:* --outfile=dist/edge-v3.js",
    "deploy:edge-v3": "node --env-file=.env.local scripts/deploy-edge-v3.mjs",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node --env-file=.env.local --import tsx src/migrate.ts",
    "db:import": "node --env-file=.env.local --import tsx src/import.ts",
    "db:validate": "tsx src/validate.ts",
    "db:refresh": "node --env-file=.env.local --import tsx src/refresh.ts",
    "db:set-password": "node --env-file=.env.local --import tsx src/set-password.ts",
    "db:verify": "node --env-file=.env.local --import tsx src/verify-live.ts",
    "db:smoke-import": "tsx src/smoke-import.ts",
    "dev:local": "node --env-file=.env.local --import tsx src/server-local.ts"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "esbuild": "^0.28.2",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
